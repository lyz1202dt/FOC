{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD Debug (FOC)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/foc.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "objdumpPath": "/usr/bin/arm-none-eabi-objdump",
            //"preLaunchTask": "Flash",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "searchDir": [
                "${workspaceFolder}"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "overrideLaunchCommands": [
                "monitor reset halt"
            ]
        },
        {
            "name": "OpenOCD Debug (Bootloader)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/bootloader.elf",
            "request": "launch",
            "type": "cortex-debug",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "objdumpPath": "/usr/bin/arm-none-eabi-objdump",
            //"preLaunchTask": "Flash",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "searchDir": [
                "${workspaceFolder}"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "overrideLaunchCommands": [
                "monitor reset halt"
            ]
        }
    ]
}
